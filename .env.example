# 复制本文件为 .env，然后填写真实值。
# .env 只保存在本地，已被 .gitignore 排除。
# Properties 格式建议不要给值额外添加引号。

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ragkb
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Redis（未设置密码时可留空）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=rag-documents

# DashScope/OpenAI 兼容接口
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_API_KEY=change-me
OPENAI_CHAT_MODEL=qwen-plus

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=text-embedding-v3

# DashScope Reranker
RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_API_KEY=change-me
RERANKER_MODEL=gte-rerank